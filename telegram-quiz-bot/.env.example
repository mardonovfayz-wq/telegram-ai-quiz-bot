# Add the real tokens in Replit Secrets. Never commit real credentials.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_api_key

# Add these as Replit Environment variables.
ADMIN_ID=your_telegram_numeric_user_id
CHANNEL_ID=@your_channel_or_-100_channel_id

# Optional; defaults to Asia/Tashkent.
TIMEZONE=Asia/Tashkent
