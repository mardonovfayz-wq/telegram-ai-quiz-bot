# Placeholders only. Never commit real values.
# On Replit, add every value below in Tools -> Secrets.
# On another host, set them as environment variables.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_api_key

# Numeric Telegram user ID of the only administrator.
ADMIN_ID=your_telegram_numeric_user_id
# Channel username (@mychannel) or numeric ID beginning with -100.
CHANNEL_ID=@your_channel_or_-100_channel_id

# Optional; defaults to Asia/Tashkent.
TIMEZONE=Asia/Tashkent

# Optional; full path of the SQLite file on a persistent disk.
# Default: telegram-quiz-bot/quiz_bot.sqlite3
QUIZ_BOT_DB_PATH=
