modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Telegram Quiz Bot"

[[workflows.workflow]]
name = "Telegram Quiz Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 telegram-quiz-bot/bot.py"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]
# ADMIN_ID and CHANNEL_ID are no longer stored in this tracked file.
# Set them in Replit Secrets (or the host environment) together with
# TELEGRAM_BOT_TOKEN and OPENAI_API_KEY.

[nix]
channel = "stable-25_05"
